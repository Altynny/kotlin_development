<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="weather"
            type="com.example.widgetsdemo2728.WeatherData" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <EditText
                android:id="@+id/editCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_city"
                android:inputType="text"
                android:imeOptions="actionDone"/>

            <Button
                android:id="@+id/buttonFetch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_get_weather"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tvCity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{weather.city}"
                android:textSize="20sp"
                android:layout_marginTop="20dp"/>

            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="120dp"
                android:layout_height="120dp"
                app:iconCode="@{weather.iconCode}"
                android:contentDescription="weather icon"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tvTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{weather.temp}"
                android:textSize="28sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{weather.description}"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvHumidity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{weather.humidity}"
                android:layout_marginTop="6dp"/>

            <TextView
                android:id="@+id/tvWind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{weather.wind}"
                android:layout_marginTop="6dp"/>

        </LinearLayout>
    </ScrollView>
</layout>
